<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Optional photo (files/dream.jpg) under a dark scrim, StandBy style; hidden when there is no photo. -->
    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/dreamScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:visibility="gone" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#B3FFFFFF"
                android:textSize="84sp"
                android:fontFamily="@font/outfit_extralight"
                android:shadowColor="#80000000"
                android:shadowRadius="12"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>
</FrameLayout>
